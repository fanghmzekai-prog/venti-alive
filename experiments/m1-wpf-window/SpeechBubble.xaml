<Window x:Class="Aeris.WindowProbe.SpeechBubble" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="温迪弹幕" Width="280" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="#204B3B" Language="zh-CN" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#245B47"/>
            <Setter Property="Background" Value="#E4F1E6"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFrame" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFrame" Property="Background" Value="#D1E8D8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonFrame" Property="BorderBrush" Value="#427A61"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonFrame" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Card" Margin="4,4,4,8" CornerRadius="15" BorderThickness="1" BorderBrush="#8CBCA6" Padding="12,9,9,10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFDF2"/>
                <GradientStop Color="#EFF8EE" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#254D3C" BlurRadius="9" ShadowDepth="2" Opacity="0.21"/>
        </Border.Effect>
        <Border.RenderTransform><TranslateTransform x:Name="Drift"/></Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="温迪" Foreground="#377858" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Line" TextWrapping="Wrap" FontSize="14" Margin="0,4,4,0"
                               AutomationProperties.AutomationId="BubbleLine"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="Dismiss" Content="×" AutomationProperties.Name="关闭弹幕"
                        AutomationProperties.AutomationId="CloseBubble" Background="Transparent" Padding="6,1"
                        FontSize="16" VerticalAlignment="Top" Style="{StaticResource QuietButton}"/>
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <Button x:Name="Reply" Content="回复" HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="ReplyBubble" Style="{StaticResource QuietButton}"/>
                <StackPanel x:Name="Editor" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="Send" DockPanel.Dock="Right" Content="发送" Margin="6,0,0,0"
                                AutomationProperties.AutomationId="SendBubble" Style="{StaticResource QuietButton}"/>
                        <TextBox x:Name="Draft" MaxLength="400" MinHeight="30" VerticalContentAlignment="Center"
                                 Padding="6,2" BorderBrush="#A7C3AF" AutomationProperties.Name="回复温迪"
                                 AutomationProperties.AutomationId="BubbleDraft"/>
                    </DockPanel>
                    <CheckBox x:Name="UseMemory" Content="使用已保存的记忆" FontSize="11" Margin="1,6,0,0"
                              AutomationProperties.AutomationId="BubbleMemory"/>
                    <TextBlock x:Name="Status" Margin="1,4,0,0" TextWrapping="Wrap" FontSize="11"
                               AutomationProperties.AutomationId="BubbleStatus"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
