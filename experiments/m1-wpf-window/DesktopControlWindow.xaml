<Window x:Class="Aeris.WindowProbe.DesktopControlWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VENTI ALIVE · 温迪桌宠" Width="480" SizeToContent="Height" ResizeMode="CanMinimize"
        Background="#F2F5EF" Foreground="#193930" FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13" Language="zh-CN" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#193930"/>
        <SolidColorBrush x:Key="Accent" Color="#226748"/>
        <SolidColorBrush x:Key="Outline" Color="#DCE7DD"/>
        <Geometry x:Key="Eye">M 2,12 Q 12,1 22,12 Q 12,23 2,12 Z M 15,12 A 3,3 0 1 1 9,12 A 3,3 0 1 1 15,12</Geometry>
        <Geometry x:Key="Lyre">M 4,4 C 1,10 3,17 9,19 Q 12,23 15,19 C 21,17 23,10 20,4 Q 16,7 12,4 Q 8,7 4,4 Z M 8,6 L 9,19 M 12,5 L 12,20 M 16,6 L 15,19</Geometry>
        <Geometry x:Key="Hips">M 15,5 A 3,3 0 1 1 9,5 A 3,3 0 1 1 15,5 M 7,13 L 3,16 L 8,19 M 17,13 L 21,16 L 16,19 M 7,13 Q 12,10 17,13 L 16,20 Q 12,22 8,20 Z</Geometry>
        <Geometry x:Key="Folded">M 15,5 A 3,3 0 1 1 9,5 A 3,3 0 1 1 15,5 M 5,18 L 5,15 Q 5,11 12,11 Q 19,11 19,15 L 19,18 Q 18,21 15,21 L 9,21 Q 6,21 5,18 Z M 6,15 L 15,19 M 18,15 L 9,19</Geometry>
        <Geometry x:Key="Doze">M 18,4 C 11,2 5,7 5,13 C 5,19 10,22 15,20 C 19,19 22,16 22,13 C 16,14 12,9 18,4 Z</Geometry>
        <Geometry x:Key="Chat">M 4,5 H 20 Q 22,5 22,7 V 15 Q 22,17 20,17 H 10 L 5,21 V 17 H 4 Q 2,17 2,15 V 7 Q 2,5 4,5 Z M 7,11 H 17</Geometry>
        <Geometry x:Key="Home">M 3,5 H 21 V 17 H 3 Z M 7,21 H 17 M 12,17 V 21 M 8,12 L 12,8 L 16,12 M 12,8 V 14</Geometry>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1,0,0,8"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="Background" Value="#FAFCF8"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#548672"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="#398060"/>
                                <Setter TargetName="Shell" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionCard" TargetType="Button" BasedOn="{StaticResource RoundButton}">
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" CornerRadius="10" Padding="9,6"
                                Background="White" BorderBrush="{StaticResource Outline}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="IconTile" Background="#E8F2E9" CornerRadius="7" Height="33">
                                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stretch="Uniform" Width="17" Height="17"
                                          Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#78A391"/>
                                <Setter TargetName="IconTile" Property="Background" Value="#D9EBDF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#398060"/>
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#E8F1E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Padding="10,0" CornerRadius="6"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <Border x:Name="Track" Grid.Column="1" Width="32" Height="18" CornerRadius="9"
                                        Background="#D7E1DC" BorderBrush="#BCCEC3" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Fill="White" Width="12" Height="12" Margin="2,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#34795B"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#34795B"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F0F6F1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="#398060"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,20,22,19" KeyboardNavigation.TabNavigation="Cycle">
            <Border CornerRadius="15" BorderBrush="#183E33" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                        <GradientStop Color="#123A30" Offset="0"/>
                        <GradientStop Color="#215344" Offset="0.56"/>
                        <GradientStop Color="#497461" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Height="154" ClipToBounds="True">
                    <Canvas HorizontalAlignment="Right" Width="207" IsHitTestVisible="False">
                        <Ellipse Width="125" Height="125" Canvas.Left="49" Canvas.Top="14"
                                 Fill="#204FFFCE" Stroke="#77C9B19A" StrokeThickness="1"/>
                        <Ellipse Width="151" Height="151" Canvas.Left="36" Canvas.Top="1"
                                 Stroke="#39C9B19A" StrokeThickness="1"/>
                        <Path Data="M 2,113 C 36,129 90,113 111,94 C 130,75 122,66 102,73"
                              Canvas.Left="23" Canvas.Top="3" Stroke="#4CCCCBA8" StrokeThickness="1.2" />
                        <Path Data="M 2,7 L 5,4 L 7,0 L 9,4 L 12,7 L 9,9 L 7,13 L 5,9 Z"
                              Canvas.Left="169" Canvas.Top="29" Fill="#9BE8EAC8"/>
                        <Ellipse Width="3" Height="3" Canvas.Left="34" Canvas.Top="43" Fill="#ABCFE9C9"/>
                        <Image x:Name="Portrait" Width="145" Height="217.5" Canvas.Left="39" Canvas.Top="-8"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Canvas>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="21,0,0,0">
                        <TextBlock Text="VENTI ALIVE" Foreground="#CAE5D3" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="温迪桌宠" Foreground="#FFF9E8" FontWeight="SemiBold" FontSize="32" Margin="0,3,0,10"/>
                        <Button x:Name="ChatButton" AutomationProperties.AutomationId="OpenOfflineChat"
                                AutomationProperties.Name="离线聊天" Style="{StaticResource RoundButton}"
                                HorizontalAlignment="Left" Background="#F3F7E9" BorderBrush="#BACCB6" MinHeight="34">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Chat}" Width="15" Height="15" Stretch="Uniform"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                                <TextBlock Text="离线聊天" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel x:Name="ActionsSection" Margin="0,15,0,0">
                <TextBlock Text="动作" Style="{StaticResource SectionTitle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="LookButton" AutomationProperties.AutomationId="PlayNotice" Content="目光回应"
                            Tag="{StaticResource Eye}" Style="{StaticResource ActionCard}"/>
                    <Button x:Name="LyreButton" Grid.Column="2" AutomationProperties.AutomationId="PlayLyre" Content="弹竖琴"
                            Tag="{StaticResource Lyre}" Style="{StaticResource ActionCard}"/>
                    <Button x:Name="HipsButton" Grid.Row="1" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayHips" Content="叉腰"
                            Tag="{StaticResource Hips}" Style="{StaticResource ActionCard}"/>
                    <Button x:Name="FoldedButton" Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayFolded"
                            Content="交叉抱臂" Tag="{StaticResource Folded}" Style="{StaticResource ActionCard}"/>
                    <Button x:Name="DozeButton" Grid.Row="2" Margin="0,8,0,0" AutomationProperties.AutomationId="PlayDoze"
                            Content="小憩" Tag="{StaticResource Doze}" Style="{StaticResource ActionCard}"/>
                </Grid>
            </StackPanel>

            <StackPanel Margin="0,15,0,0">
                <TextBlock Text="桌面设置" Style="{StaticResource SectionTitle}"/>
                <Border Background="White" BorderBrush="{StaticResource Outline}" BorderThickness="1"
                        CornerRadius="11" Padding="4,4">
                    <StackPanel>
                        <CheckBox x:Name="CharacterVisible" AutomationProperties.AutomationId="CharacterVisible"
                                  Content="显示角色" Style="{StaticResource SettingSwitch}"/>
                        <CheckBox x:Name="Playing" AutomationProperties.AutomationId="PlayAnimation"
                                  Content="播放动画" Style="{StaticResource SettingSwitch}"/>
                        <CheckBox x:Name="Autonomous" AutomationProperties.AutomationId="RandomActions"
                                  Content="随机播放待机动作" Style="{StaticResource SettingSwitch}"/>
                        <CheckBox x:Name="TopmostCharacter" AutomationProperties.AutomationId="TopmostCharacter"
                                  Content="置顶角色" Style="{StaticResource SettingSwitch}"/>
                        <CheckBox x:Name="PassThrough" AutomationProperties.AutomationId="PassThrough"
                                  Content="全窗口点击穿透" Style="{StaticResource SettingSwitch}"/>
                        <CheckBox x:Name="StartWithWindows" AutomationProperties.AutomationId="StartWithWindows"
                                  Content="开机自启动" Style="{StaticResource SettingSwitch}"
                                  ToolTip="登录 Windows 后启动温迪，主控窗口最小化到任务栏"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="ActiveSection" Margin="0,15,0,0">
                <TextBlock Text="主动互动" Style="{StaticResource SectionTitle}"/>
                <Border Background="White" BorderBrush="{StaticResource Outline}" BorderThickness="1"
                        CornerRadius="11" Padding="4">
                    <StackPanel>
                        <CheckBox x:Name="ProactiveSpeech" AutomationProperties.AutomationId="ProactiveSpeech"
                                  Content="主动说话" Style="{StaticResource SettingSwitch}"
                                  ToolTip="温迪偶尔用离线模型主动开口"/>
                        <CheckBox x:Name="AutonomousFlight" AutomationProperties.AutomationId="AutonomousFlight"
                                  Content="自主飞行" Style="{StaticResource SettingSwitch}"
                                  ToolTip="一段时间没有互动时，温迪偶尔在当前屏幕短飞"/>
                        <DockPanel Margin="11,3,8,3" MinHeight="32">
                            <ComboBox x:Name="BubbleDuration" DockPanel.Dock="Right" Width="76" VerticalAlignment="Center"
                                      AutomationProperties.Name="弹幕停留时间" AutomationProperties.AutomationId="BubbleDuration">
                                <ComboBoxItem Content="5 秒"/>
                                <ComboBoxItem Content="7 秒"/>
                                <ComboBoxItem Content="10 秒"/>
                            </ComboBox>
                            <TextBlock Text="弹幕停留时间" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RecallButton" HorizontalAlignment="Left" AutomationProperties.AutomationId="RecallCharacter"
                        AutomationProperties.Name="角色回到主屏中央" Style="{StaticResource RoundButton}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource Home}" Width="15" Height="15" Stretch="Uniform"
                              Stroke="{StaticResource Accent}" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                        <TextBlock Text="召回主屏" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExitButton" Grid.Column="1" Content="退出温迪" AutomationProperties.AutomationId="ExitVenti"
                        Background="Transparent" Foreground="#5C6D64" Style="{StaticResource RoundButton}"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
